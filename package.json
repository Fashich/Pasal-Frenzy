{
  "name": "pasal-frenzy",
  "version": "0.1.0",
  "private": true,
  "description": "Web game 3D naratif-kritis tentang Undang-Undang Dasar Negara Republik Indonesia Tahun 1945",
  "author": "Fashich",
  "license": "MIT",
  "type": "module",
  "homepage": "https://fashich.github.io/Pasal-Frenzy/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fashich/Pasal-Frenzy.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:pages": "cross-env VITE_TARGET=pages npm run build",
    "build:app": "cross-env VITE_TARGET=app npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:build": "python scripts/build-uud1945.py",
    "data:validate": "python scripts/build-uud1945.py --validate-only"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "aframe": "1.8.0",
    "comlink": "4.4.2",
    "gsap": "3.15.0",
    "idb": "8.0.3",
    "lenis": "1.3.26",
    "phaser": "3.90.0",
    "three": "npm:super-three@0.184.0",
    "troika-three-text": "0.52.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/three": "0.184.1",
    "cross-env": "^10.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "happy-dom": "^20.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-glsl": "1.6.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
